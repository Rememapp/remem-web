# Public site URL (used for canonical URLs, sitemap, OG, RSS)
NEXT_PUBLIC_SITE_URL=https://remem.app

# The remem-api worker the waitlist/contact forms post to (see src/lib/remem-api.ts).
# Unset → production (https://remem-api.itssvk.dev). For a full local stack, run `bun run cf`
# in ../remem-api and point here at it:
NEXT_PUBLIC_REMEM_API_URL=http://localhost:8787

# Cloudflare Turnstile sitekey — the public half of remem-api's TURNSTILE_SECRET_KEY pair
# (dash.cloudflare.com → Turnstile). Unset → the widget doesn't render and forms submit without a
# captcha token, which the API accepts only while its secret is also unset. The two must be from
# the same widget (or both be Cloudflare's test pair) or verification always fails.
# Always-passing test sitekey for local dev:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
