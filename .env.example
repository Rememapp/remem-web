# Public site URL (used for canonical URLs, sitemap, OG, RSS)
NEXT_PUBLIC_SITE_URL=https://remem.app

# Waitlist storage via Resend Audiences (optional — falls back to .data/waitlist.json in dev)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Contact form delivery via Resend (optional — logs to server console when unset)
CONTACT_TO_EMAIL=
